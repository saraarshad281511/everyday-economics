# Copy this file to ".env" and fill in the values.

# Postgres connection string (local Docker DB, or your Neon/Supabase URL in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/everyday

# A long random string. Generate one with:  openssl rand -hex 32
PAYLOAD_SECRET=change-me

# The public address of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Only needed in production on Vercel (image uploads). Created automatically when you add Vercel Blob.
# BLOB_READ_WRITE_TOKEN=
